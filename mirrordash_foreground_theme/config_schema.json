{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Foreground Theme",
  "description": "Seasonal decoration over the mirror. Put it in Foreground. Each theme has its own settings below. Shapes that keep moving keep the Raspberry Pi drawing (warmer, and a video beside it may stutter); showers or still shapes cost next to nothing.",
  "type": "object",
  "properties": {
    "theme": {
      "type": "string",
      "title": "Theme",
      "description": "By date: Birthday (on the birthdays below), New Year (12-31 to 01-01), Easter (palm sunday to easter monday), Midsummer (midsummer eve to sunday), Halloween (10-25 to 10-31), Snow (12-01 to 01-06), Hearts (02-10 to 02-14), Spring petals (04-01 to 05-31), Autumn leaves (09-20 to 11-15). Each theme's own block below changes its days. Or one theme all year.",
      "default": "auto",
      "enum": [
        "auto",
        "birthday",
        "newyear",
        "easter",
        "midsummer",
        "halloween",
        "snow",
        "hearts",
        "petals",
        "leaves",
        "stars",
        "rain"
      ],
      "enum_titles": [
        "By date",
        "Birthday",
        "New Year",
        "Easter",
        "Midsummer",
        "Halloween",
        "Snow",
        "Hearts",
        "Spring petals",
        "Autumn leaves",
        "Stars",
        "Rain"
      ]
    },
    "shower_every": {
      "type": "integer",
      "default": 1,
      "title": "Minutes Between",
      "description": "Showers: how often one comes by itself."
    },
    "shower_on_arrival": {
      "type": "boolean",
      "default": true,
      "title": "Move When Someone Comes",
      "description": "Showers: one when the motion sensor sees someone at the mirror."
    },
    "shower_on_wake": {
      "type": "boolean",
      "default": true,
      "title": "Move When the Screen Wakes",
      "description": "Showers: one when the screen turns on, this module's schedule begins or privacy mode ends."
    },
    "birthday": {
      "type": "object",
      "title": "Birthday",
      "description": "The birthday theme's settings.",
      "properties": {
        "by_date": {
          "type": "boolean",
          "title": "Show By Date",
          "default": true,
          "description": "When Theme is By date. On the birthdays below."
        },
        "mode": {
          "type": "string",
          "title": "Movement",
          "description": "Showers: half a minute that fades in and out, then nothing until the next one; best when the screen is on for hours. All the time: moves while the screen is on; best when it only lights up when someone comes. Still: never moves.",
          "default": "showers",
          "enum": [
            "showers",
            "falling",
            "still"
          ],
          "enum_titles": [
            "Showers",
            "All the time",
            "Still"
          ]
        },
        "variant": {
          "type": "string",
          "title": "Shapes",
          "description": "",
          "default": "confetti",
          "enum": [
            "confetti",
            "streamers",
            "balloons",
            "dots"
          ],
          "enum_titles": [
            "Confetti",
            "Confetti and streamers",
            "Balloons",
            "Confetti and dots"
          ]
        },
        "palette": {
          "type": "string",
          "title": "Colours",
          "description": "",
          "default": "party",
          "enum": [
            "party",
            "gold",
            "pastel"
          ],
          "enum_titles": [
            "Party",
            "Gold",
            "Pastel"
          ]
        },
        "motion": {
          "type": "string",
          "title": "Motion",
          "description": "How the shapes move. Those marked heavy draw each shape on its own: best with Showers.",
          "default": "spin_each",
          "enum": [
            "straight",
            "wind",
            "sway",
            "sway_each",
            "spin_each"
          ],
          "enum_titles": [
            "Straight down",
            "Slanting, as in wind",
            "Swaying (the whole layer; uses more while it moves)",
            "Swaying one by one (heavy for the Pi)",
            "Spinning one by one (heavy for the Pi)"
          ]
        },
        "amount": {
          "type": "integer",
          "format": "slider",
          "title": "How Many",
          "description": "Fewer are calmer; above 4 a second layer is drawn (with wind, never: the Pi's GPU memory).",
          "default": 4,
          "minimum": 1,
          "maximum": 10,
          "step": 1
        },
        "size": {
          "type": "integer",
          "format": "slider",
          "title": "Size (%)",
          "description": "How large the shapes are.",
          "default": 110,
          "minimum": 50,
          "maximum": 200,
          "step": 10
        },
        "brightness": {
          "type": "integer",
          "format": "slider",
          "title": "Brightness (%)",
          "description": "How bright the shapes are.",
          "default": 85,
          "minimum": 10,
          "maximum": 100,
          "step": 5
        },
        "speed": {
          "type": "integer",
          "format": "slider",
          "title": "Speed (%)",
          "description": "Faster makes the Pi draw more often while it moves.",
          "default": 100,
          "minimum": 25,
          "maximum": 300,
          "step": 25
        },
        "people": {
          "type": "array",
          "title": "Birthdays",
          "default": [],
          "description": "Whose birthdays: confetti and their name on the day.",
          "items": {
            "type": "object",
            "title": "Birthday",
            "properties": {
              "name": {
                "type": "string",
                "title": "Name"
              },
              "date": {
                "type": "string",
                "title": "Date",
                "description": "MM-DD (or YYYY-MM-DD)."
              }
            }
          }
        },
        "greeting_at": {
          "type": "string",
          "title": "Where the Text Is",
          "description": "The greeting stays all day.",
          "default": "quarter",
          "enum": [
            "quarter",
            "golden",
            "middle",
            "bottom",
            "none"
          ],
          "enum_titles": [
            "A quarter down",
            "Golden ratio (38%)",
            "The middle",
            "Bottom edge",
            "No text"
          ]
        },
        "font": {
          "type": "string",
          "title": "Font",
          "description": "",
          "default": "inter",
          "enum": [
            "inter",
            "sacramento",
            "great_vibes",
            "dancing_script",
            "pacifico",
            "caveat",
            "amatic_sc",
            "fredoka",
            "lobster"
          ],
          "enum_titles": [
            "Inter, thin",
            "Sacramento, a thin script",
            "Great Vibes, an elegant script",
            "Dancing Script, a cheerful script",
            "Pacifico, retro",
            "Caveat, handwritten",
            "Amatic SC, hand-drawn capitals",
            "Fredoka, round and playful",
            "Lobster, bold and festive"
          ]
        }
      },
      "show_if": {
        "theme": [
          "auto",
          "birthday"
        ]
      }
    },
